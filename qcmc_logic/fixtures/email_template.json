 {
  "docstatus": 0,
  "doctype": "Email Template",
  "name": "Leave Approval Notification",
  "response": "<h1>Leave Application Notification</h1>\n<h3>Details:</h3>\n\n\t<table class=\"table table-bordered small\" style=\"max-width:500px\">\n\t\t<tbody><tr>\n\t\t\t<td>Employee</td>\n\t\t\t<td>{{employee_name}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Leave Type</td>\n\t\t\t<td>{{leave_type}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>From Date</td>\n\t\t\t<td>{{from_date}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>To Date</td>\n\t\t\t<td>{{to_date}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Status</td>\n\t\t\t<td>{{status}}</td>\n\t\t</tr>\n\t</tbody></table>\n\n\t{% set doc_link = frappe.utils.get_url_to_form('Leave Application', name) %}\n\n\t<br><br>\n\t<a class=\"btn btn-primary\" href=\"{{ doc_link }}\" target=\"_blank\" rel=\"noopener noreferrer\">{{ _('Open Now') }}</a>",
  "response_html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<style>\r\n  body { margin: 0; padding: 0; background: #f4f4f4; font-family: Arial, sans-serif; }\r\n  .wrapper { background: #f4f4f4; padding: 32px 16px; }\r\n  .container { max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }\r\n  .header { background: #1D6F42; padding: 28px 32px; text-align: center; }\r\n  .header h1 { margin: 0; color: #ffffff; font-size: 20px; font-weight: 600; letter-spacing: 0.3px; }\r\n  .header p { margin: 6px 0 0; color: #a7d4b8; font-size: 13px; }\r\n  .body { padding: 28px 32px; }\r\n  .greeting { font-size: 15px; color: #1a1a1a; margin: 0 0 16px; }\r\n  .status-badge { display: inline-block; padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-bottom: 20px; }\r\n  .approved { background: #e6f4ea; color: #1a6b3c; }\r\n  .details-box { background: #f8f9fa; border-left: 3px solid #1D6F42; border-radius: 0 6px 6px 0; padding: 16px 20px; margin-bottom: 20px; }\r\n  .detail-row { display: flex; justify-content: space-between; font-size: 13.5px; padding: 5px 0; color: #333; border-bottom: 1px solid #ececec; }\r\n  .detail-row:last-child { border-bottom: none; }\r\n  .detail-label { color: #666; }\r\n  .detail-value { font-weight: 600; color: #1a1a1a; }\r\n  .message-box { background: #fffbea; border: 1px solid #f0e0a0; border-radius: 6px; padding: 14px 18px; margin-bottom: 20px; font-size: 13px; color: #5a4a00; line-height: 1.6; }\r\n  .message-box strong { display: block; margin-bottom: 4px; color: #3d3000; }\r\n  .cta { text-align: center; margin: 24px 0 8px; }\r\n  .cta a { background: #1D6F42; color: #ffffff; text-decoration: none; padding: 11px 28px; border-radius: 6px; font-size: 14px; font-weight: 600; display: inline-block; }\r\n  .footer { background: #f0f0f0; padding: 16px 32px; text-align: center; font-size: 11.5px; color: #888; line-height: 1.6; }\r\n  .footer a { color: #1D6F42; text-decoration: none; }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"wrapper\">\r\n  <div class=\"container\">\r\n    <div class=\"header\">\r\n      <h1>Leave Approval Notification</h1>\r\n      <p>Human Resources · {{ company }}</p>\r\n    </div>\r\n    <div class=\"body\">\r\n      <p class=\"greeting\">Dear {{ employee_name }},</p>\r\n      <p style=\"font-size:14px; color:#444; margin:0 0 14px; line-height:1.6;\">\r\n        Your leave application has been reviewed. Please find the details below.\r\n      </p>\r\n\r\n      <span class=\"status-badge approved\">✔ Approved</span>\r\n\r\n      <div class=\"details-box\">\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Leave Type</span>\r\n          <span class=\"detail-value\">{{ leave_type }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">From Date</span>\r\n          <span class=\"detail-value\">{{ from_date }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">To Date</span>\r\n          <span class=\"detail-value\">{{ to_date }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Total Days</span>\r\n          <span class=\"detail-value\">{{ total_leave_days }} day(s)</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Applied On</span>\r\n          <span class=\"detail-value\">{{ posting_date }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Approved By</span>\r\n          <span class=\"detail-value\">{{ leave_approver }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      {% if description %}\r\n      <div class=\"message-box\">\r\n        <strong>Reason / Remarks:</strong>\r\n        {{ description }}\r\n      </div>\r\n      {% endif %}\r\n\r\n      <div class=\"cta\">\r\n        <a href=\"{{ frappe.utils.get_url_to_form(\"Leave Application\", name) }}\">View Leave Application</a>\r\n      </div>\r\n\r\n      <p style=\"font-size:13px; color:#666; margin-top:20px; line-height:1.6;\">\r\n        If you have any questions, please contact your HR department or your leave approver directly.\r\n      </p>\r\n      <p style=\"font-size:13px; color:#444; margin:0;\">Best regards,<br><strong>HR Team · {{ company }}</strong></p>\r\n    </div>\r\n    <div class=\"footer\">\r\n      This is an automated notification from <a href=\"#\">{{ company }}</a>. Please do not reply to this email.<br>\r\n      &copy; {{ frappe.utils.nowdate()[:4] }} {{ company }}. All rights reserved.\r\n    </div>\r\n  </div>\r\n</div>\r\n</body>\r\n</html>",
  "subject": "Leave Approval Notification",
  "use_html": 1
 },
 {
  "docstatus": 0,
  "doctype": "Email Template",
  "name": "Leave Status Notification",
  "response": "<h1>Leave Application Notification</h1>\n<h3>Details:</h3>\n\n\t<table class=\"table table-bordered small\" style=\"max-width:500px\">\n\t\t<tbody><tr>\n\t\t\t<td>Employee</td>\n\t\t\t<td>{{employee_name}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Leave Type</td>\n\t\t\t<td>{{leave_type}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>From Date</td>\n\t\t\t<td>{{from_date}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>To Date</td>\n\t\t\t<td>{{to_date}}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Status</td>\n\t\t\t<td>{{status}}</td>\n\t\t</tr>\n\t</tbody></table>\n\n\t{% set doc_link = frappe.utils.get_url_to_form('Leave Application', name) %}\n\n\t<br><br>\n\t<a class=\"btn btn-primary\" href=\"{{ doc_link }}\" target=\"_blank\" rel=\"noopener noreferrer\">{{ _('Open Now') }}</a>",
  "response_html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\r\n<style>\r\n  body{margin:0;padding:0;background:#f4f4f4;font-family:Arial,sans-serif;}\r\n  .wrapper{background:#f4f4f4;padding:32px 16px;}\r\n  .container{max-width:580px;margin:0 auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);}\r\n  .header{padding:28px 32px;text-align:center;}\r\n  .header h1{margin:0;color:#fff;font-size:20px;font-weight:600;letter-spacing:0.3px;}\r\n  .header p{margin:6px 0 0;font-size:13px;opacity:0.8;color:#fff;}\r\n  .body{padding:28px 32px;}\r\n  .greeting{font-size:15px;color:#1a1a1a;margin:0 0 14px;}\r\n  .status-badge{display:inline-block;padding:5px 16px;border-radius:20px;font-size:13px;font-weight:700;margin-bottom:20px;letter-spacing:0.2px;}\r\n  .details-box{background:#f8f9fa;border-left:3px solid #ccc;border-radius:0 6px 6px 0;padding:16px 20px;margin-bottom:20px;}\r\n  .detail-row{display:flex;justify-content:space-between;font-size:13.5px;padding:5px 0;color:#333;border-bottom:1px solid #ececec;}\r\n  .detail-row:last-child{border-bottom:none;}\r\n  .detail-label{color:#666;}\r\n  .detail-value{font-weight:600;color:#1a1a1a;}\r\n  .remark-box{border-radius:6px;padding:14px 18px;margin-bottom:20px;font-size:13px;line-height:1.6;}\r\n  .remark-box strong{display:block;margin-bottom:4px;}\r\n  .cta{text-align:center;margin:24px 0 8px;}\r\n  .cta a{text-decoration:none;padding:11px 28px;border-radius:6px;font-size:14px;font-weight:600;display:inline-block;color:#fff;}\r\n  .footer{background:#f0f0f0;padding:16px 32px;text-align:center;font-size:11.5px;color:#888;line-height:1.6;}\r\n  .footer a{color:#555;text-decoration:none;}\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"wrapper\">\r\n  <div class=\"container\">\r\n\r\n    {% if status == \"Approved\" %}\r\n    <div class=\"header\" style=\"background:#1D6F42;\">\r\n      <h1>Leave Status Notification</h1>\r\n      <p>Human Resources &middot; {{ company }}</p>\r\n    </div>\r\n    {% elif status == \"Rejected\" %}\r\n    <div class=\"header\" style=\"background:#c0392b;\">\r\n      <h1>Leave Status Notification</h1>\r\n      <p>Human Resources &middot; {{ company }}</p>\r\n    </div>\r\n    {% else %}\r\n    <div class=\"header\" style=\"background:#1a56db;\">\r\n      <h1>Leave Status Notification</h1>\r\n      <p>Human Resources &middot; {{ company }}</p>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <div class=\"body\">\r\n      <p class=\"greeting\">Dear {{ employee_name }},</p>\r\n      <p style=\"font-size:14px;color:#444;margin:0 0 14px;line-height:1.6;\">\r\n        Your leave application status has been updated. Please review the details below.\r\n      </p>\r\n\r\n      {% if status == \"Approved\" %}\r\n        <span class=\"status-badge\" style=\"background:#e6f4ea;color:#1a6b3c;\">&#10004; Approved</span>\r\n      {% elif status == \"Rejected\" %}\r\n        <span class=\"status-badge\" style=\"background:#fdecea;color:#b71c1c;\">&#10008; Rejected</span>\r\n      {% else %}\r\n        <span class=\"status-badge\" style=\"background:#e8f0fe;color:#1a56db;\">&#9679; Open / Pending</span>\r\n      {% endif %}\r\n\r\n      {% if status == \"Approved\" %}\r\n      <div class=\"details-box\" style=\"border-left-color:#1D6F42;\">\r\n      {% elif status == \"Rejected\" %}\r\n      <div class=\"details-box\" style=\"border-left-color:#c0392b;\">\r\n      {% else %}\r\n      <div class=\"details-box\" style=\"border-left-color:#1a56db;\">\r\n      {% endif %}\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Employee</span>\r\n          <span class=\"detail-value\">{{ employee_name }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Leave Type</span>\r\n          <span class=\"detail-value\">{{ leave_type }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">From Date</span>\r\n          <span class=\"detail-value\">{{ from_date }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">To Date</span>\r\n          <span class=\"detail-value\">{{ to_date }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Total Days</span>\r\n          <span class=\"detail-value\">{{ total_leave_days }} day(s)</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Status</span>\r\n          <span class=\"detail-value\">{{ status }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Approver</span>\r\n          <span class=\"detail-value\">{{ leave_approver }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      {% if description %}\r\n      {% if status == \"Approved\" %}\r\n      <div class=\"remark-box\" style=\"background:#fffbea;border:1px solid #f0e0a0;color:#5a4a00;\">\r\n        <strong style=\"color:#3d3000;\">Remarks:</strong>{{ description }}\r\n      </div>\r\n      {% elif status == \"Rejected\" %}\r\n      <div class=\"remark-box\" style=\"background:#fff5f5;border:1px solid #f5c6c6;color:#7a1f1f;\">\r\n        <strong style=\"color:#5a0f0f;\">Reason for Rejection:</strong>{{ description }}\r\n      </div>\r\n      {% else %}\r\n      <div class=\"remark-box\" style=\"background:#eef2ff;border:1px solid #b3c6f7;color:#1a3a8f;\">\r\n        <strong style=\"color:#0f2266;\">Notes:</strong>{{ description }}\r\n      </div>\r\n      {% endif %}\r\n      {% endif %}\r\n\r\n      <div class=\"cta\">\r\n        {% if status == \"Approved\" %}\r\n        <a href=\"{{ frappe.utils.get_url_to_form(\"Leave Application\", name) }}\" style=\"background:#1D6F42;\">View Approved Leave</a>\r\n        {% elif status == \"Rejected\" %}\r\n        <a href=\"{{ frappe.utils.get_url_to_form(\"Leave Application\", name) }}\" style=\"background:#c0392b;\">View Leave Application</a>\r\n        {% else %}\r\n        <a href=\"{{ frappe.utils.get_url_to_form(\"Leave Application\", name) }}\" style=\"background:#1a56db;\">View Leave Application</a>\r\n        {% endif %}\r\n      </div>\r\n\r\n      <p style=\"font-size:13px;color:#666;margin-top:20px;line-height:1.6;\">\r\n        For any concerns, please reach out to your HR department or leave approver directly.\r\n      </p>\r\n      <p style=\"font-size:13px;color:#444;margin:0;\">\r\n        Best regards,<br><strong>HR Team &middot; {{ company }}</strong>\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"footer\">\r\n      This is an automated notification from <a href=\"#\">{{ company }}</a>. Please do not reply to this email.<br>\r\n      &copy; {{ frappe.utils.nowdate()[:4] }} {{ company }}. All rights reserved.\r\n    </div>\r\n  </div>\r\n</div>\r\n</body>\r\n</html>",
  "subject": "Leave Status Notification",
  "use_html": 1
 },
